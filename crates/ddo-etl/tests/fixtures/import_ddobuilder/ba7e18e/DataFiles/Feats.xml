<Feats>
  
  <!--A list of all the standard feats that can be selected in game-->
  
  
  
  <Feat>
    <Name>Alertness</Name>
    <Description>Provides a +2 bonus to your Listen and Spot skills.</Description>
    <Group>Standard</Group>
    <Group>Epic Feat</Group>
    <Acquire>Train</Acquire>
    <Icon>Alertness</Icon>
    <Effect>
      <Type>SkillBonus</Type>
      <Bonus>Feat</Bonus>
      <Item>Listen</Item>
      <Item>Spot</Item>
      <AType>Simple</AType>
      <Amount size="1">2</Amount>
    </Effect>
  </Feat>
  
  <Feat>
    <Name>Attack</Name>
    <Description>This is the standard attack for all characters. It can be toggled on to
attack repeatedly until your target is defeated, or activated once by right-clicking the mouse.</Description>
    <MaxTimesAcquire>1</MaxTimesAcquire>
    <Acquire>Automatic</Acquire>
    <Icon>Attack</Icon>
    <AutomaticAcquisition>
      <Requirement>
        <Type>Level</Type>
        <Value>1</Value>
      </Requirement>
    </AutomaticAcquisition>
    <Attack>
      <Name>Basic Attack</Name>
      <Description>You attack with your weapon</Description>
      <Icon>Attack</Icon>
      <Cooldown size="1">0</Cooldown>
      <ThisAttack>
        <!--No special entries as its just standard damage-->
      </ThisAttack>
    </Attack>
    <!--tumble charges-->
    <Effect>
      <DisplayName>Tumble Base Charges</DisplayName>
      <Type>TumbleCharge</Type>
      <Bonus>Feat</Bonus>
      <AType>Simple</AType>
      <Amount size="1">2</Amount>
    </Effect>
    <Effect>
      <DisplayName>10 Skill Ranks in Tumble</DisplayName>
      <Type>TumbleCharge</Type>
      <Bonus>Enhancement</Bonus>
      <AType>Simple</AType>
      <Amount size="1">1</Amount>
      <Requirements>
        <Requirement>
          <Type>Skill</Type>
          <Item>Tumble</Item>
          <Value>10</Value>
        </Requirement>
        <RequiresOneOf>
          <Requirement>
            <Type>Stance</Type>
            <Item>Cloth Armor</Item>
          </Requirement>
          <Requirement>
            <Type>Stance</Type>
            <Item>Light Armor</Item>
          </Requirement>
        </RequiresOneOf>
      </Requirements>
    </Effect>
    <Effect>
      <DisplayName>20 Skill Ranks in Tumble</DisplayName>
      <Type>TumbleCharge</Type>
      <Bonus>Enhancement</Bonus>
      <AType>Simple</AType>
      <Amount size="1">1</Amount>
      <Requirements>
        <Requirement>
          <Type>Skill</Type>
          <Item>Tumble</Item>
          <Value>20</Value>
        </Requirement>
        <RequiresOneOf>
          <Requirement>
            <Type>Stance</Type>
            <Item>Cloth Armor</Item>
          </Requirement>
          <Requirement>
            <Type>Stance</Type>
            <Item>Light Armor</Item>
          </Requirement>
        </RequiresOneOf>
      </Requirements>
    </Effect>
