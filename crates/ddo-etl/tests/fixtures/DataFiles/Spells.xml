      <Item>Fear</Item>
    </Effect>
  </Spell>
  <Spell>
    <Name>Divine Favor</Name>
    <Description>Calling upon the strength and wisdom of a deity, you gain a +1 luck bonus on attack
and weapon damage rolls. This bonus is increased by +1 for every 3 caster
levels beyond level 3. (Maximum bonus +3 at caster level 9.)</Description>
    <Icon>DivineFavor</Icon>
    <School>Evocation</School>
    <Extend />
    <Quicken />
    <MaxCasterLevel>9</MaxCasterLevel>
