      <Item>All</Item>
    </Effect>
  </Spell>
  <Spell>
    <Name>Static Shock</Name>
    <Description>An Electrical discharge strikes one target for 1d6 Electricity damage plus 1d6 Electricity
damage per two caster levels up to a maximum damage of 6d6 at caster level 10.
A successful Reflex save reduces this damage by half.
On a failed save, the target must make a successful Will save or be dazed for
a short period of time or until they take damage.</Description>
    <Icon>StaticShock</Icon>
    <School>Evocation</School>
    <Embolden />
    <Empower />
    <Enlarge />
    <Heighten />
    <Intensify />
    <Maximize />
    <Quicken />
    <MaxCasterLevel>10</MaxCasterLevel>
    <SpellDamage>
      <SpellDice>
        <BaseDice>
          <Number>1</Number>
          <Sides>6</Sides>
        </BaseDice>
        <PerCasterLevels>2</PerCasterLevels>
        <BonusDice>
          <Number>1</Number>
          <Sides>6</Sides>
        </BonusDice>
      </SpellDice>
      <Damage>Electric</Damage>
      <SpellPower>Electric</SpellPower>
    </SpellDamage>
    <SpellDC>
      <DCType>Half Damage</DCType>
      <DCVersus>Reflex</DCVersus>
      <School>Evocation</School>
      <CastingStatMod />
    </SpellDC>
  </Spell>
  <Spell>
    <Name>Bull's Strength</Name>
    <Description>An ally gains a +4 Enhancement bonus to Strength for 1 minute per caster level.</Description>
