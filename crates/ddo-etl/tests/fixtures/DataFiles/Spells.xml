      <ApplyAsItemEffect />
    </Effect>
  </Spell>
  <Spell>
    <Name>Cure Light Wounds</Name>
    <Description>Positive energy heals an ally for 1d6+2 plus 1 per caster level (Maximum caster level 5.)
hit points, or deals the same amount of damage to an Undead creature.
A successful Will save takes half damage (undead only).</Description>
    <Icon>CureLightWounds</Icon>
    <School>Conjuration</School>
    <Empower />
    <EmpowerHealing />
    <Enlarge />
    <Intensify />
    <Maximize />
