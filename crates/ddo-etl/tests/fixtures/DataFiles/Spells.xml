<Spells>
  
  <Spell>
    <Name>Resist Energy</Name>
    <Description>Gives an ally limited resistance from one chosen energy type, reducing damage or
attack by 10. (20 at caster level 7th, 30 at 11th.)
Energy types available are: Acid, Cold, Electricity, Fire, or Sonic.</Description>
    <Icon>ResistEnergy</Icon>
    <School>Abjuration</School>
    <Enlarge />
    <Extend />
    <Quicken />
    <Effect>
      <Type>EnergyResistance</Type>
      <Bonus>Enhancement</Bonus>
      <AType>ClassCasterLevel</AType>
      <StackSource>Unknown</StackSource>
      <Amount size="41">0 10 10 10 10 10 10 20 20 20 20 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30 30</Amount>
      <Item>Acid</Item>
      <Item>Cold</Item>
      <Item>Electric</Item>
      <Item>Fire</Item>
      <Item>Sonic</Item>
    </Effect>
  </Spell>
  <Spell>
    <Name>Resistance</Name>
    <Description>Imbues the ally with magical energy that protects from harm, granting them a +1
Resistance bonus on saves (+2 at 6th level, +3 at 9th level).</Description>
    <Icon>Resistance</Icon>
    <School>Abjuration</School>
    <Extend />
    <Quicken />
