  <Spell>
    <Name>Lesser Restoration</Name>
    <Description>Dispels magical effects reducing 1 of an allies Ability scores, it also eliminates
the condition Fatigued suffered by the creature, and improves the Exhausted
condition to Fatigued.</Description>
    <Icon>LesserRestoration</Icon>
    <School>Conjuration</School>
    <Enlarge />
    <Quicken />
  </Spell>
