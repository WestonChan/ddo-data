<Buff>
    <Type>Aligned</Type>
    <DisplayText>Aligned: This weapon transmutes into a form that is able to bypass any alignment based Damage Reduction. (Chaotic, Good, Evil, Lawful)</DisplayText>
    <ApplyToWeaponOnly />
    <Effect>
      <Type>DRBypass</Type>
      <Bonus>Equipment</Bonus>
      <AType>NotNeeded</AType>
      <Value>Chaotic</Value>
      <Item>All</Item>
    </Effect>
    <Effect>
      <Type>DRBypass</Type>
      <Bonus>Equipment</Bonus>
      <AType>NotNeeded</AType>
      <Value>Good</Value>
      <Item>All</Item>
    </Effect>
    <Effect>
      <Type>DRBypass</Type>
      <Bonus>Equipment</Bonus>
      <AType>NotNeeded</AType>
      <Value>Evil</Value>
      <Item>All</Item>
    </Effect>
    <Effect>
      <Type>DRBypass</Type>
      <Bonus>Equipment</Bonus>
      <AType>NotNeeded</AType>
      <Value>Lawful</Value>
      <Item>All</Item>
    </Effect>
  </Buff>
<Buff>
    <Type>Elasticity</Type>
    <DisplayText>Elasticity: This bow is strung with special fibers that cause it to occasionally launch arrows with shocking force. When rolling a 19 or 20 on a ranged attack, your critical multiplier is increased by +1.</DisplayText>
    <Effect>
      <Type>Weapon_CriticalMultiplier19To20</Type>
      <Bonus>Base</Bonus>
      <AType>Simple</AType>
      <Amount size="1">1</Amount>
      <Item>All</Item>
    </Effect>
  </Buff>
<Buff>
    <Type>Overfocus</Type>
    <DisplayText>Overfocus: This item helps you focus your attention, but it makes you somewhat oblivious to your surroundings, causing a -10 penalty to Search and Spot.</DisplayText>
    <Effect>
      <Type>SkillBonus</Type>
      <Bonus>Penalty</Bonus>
      <AType>Simple</AType>
      <Amount size="1">-10</Amount>
      <Item>Search</Item>
      <Item>Spot</Item>
    </Effect>
  </Buff>
<Buff>
    <Type>Revel in Blood (Piercing)</Type>
    <DisplayText>Revel in Blood (Piercing): Your weapon hungers to let blood flow. Your attacks and offensive spells have a high chance to deal very strong Bane damage over time to creatures vulnerable to Bleeding. On weapon critical: 16d6 Piercing Damage.</DisplayText>
    <Effect>
      <Type>WeaponOtherDamageBonus</Type>
      <Type>WeaponOtherDamageBonusCritical</Type>
      <Bonus>Not Set</Bonus>
      <AType>NotNeeded</AType>
      <Dice>
        <Number size="1">16</Number>
        <Sides size="1">6</Sides>
        <Damage>Pierce</Damage>
      </Dice>
      <Item>All</Item>
    </Effect>
  </Buff>
<Buff>
    <Type>StealthStrike</Type>
    <DisplayText>Stealth Strike: Reduces the threat generated by ranged attacks and spells by 15%.</DisplayText>
    <Effect>
      <Type>ThreatBonusRanged</Type>
      <Type>ThreatBonusSpell</Type>
      <Bonus>Insightful</Bonus>
      <AType>Simple</AType>
      <Amount size="1">-15</Amount>
    </Effect>
  </Buff>
