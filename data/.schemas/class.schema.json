        "$ref": "#/$defs/Skill"
      },
      "type": "array"
    },
    "skill_points": {
      "format": "int64",
      "type": "integer"
    },
    "small_icon": {
      "type": [
        "string",
        "null"
      ],
      "x-image-kind": "classes"
    },
    "spell": {
