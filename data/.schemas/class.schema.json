        "spell_level": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "class_level",
        "slots",
        "spell_level"
      ],
      "type": "object",
      "x-table": "class_spell_slots"
    },
    "FileNumber": {
      "anyOf": [
        {
