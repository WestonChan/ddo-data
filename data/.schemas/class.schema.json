        },
        "feat_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "feat_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "level"
      ],
      "type": "object",
      "x-table": "class_auto_feats"
    },
    "ClassFeatSlot": {
