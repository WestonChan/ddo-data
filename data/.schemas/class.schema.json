        },
        "spell_level": {
          "format": "int64",
          "type": "integer"
        },
        "spell_name": {
          "type": "string"
        }
      },
      "required": [
        "spell_level",
        "spell_name"
      ],
      "type": "object",
      "x-table": "class_spells"
    },
    "ClassSpellSlot": {
      "additionalProperties": false,
      "properties": {
        "class_level": {
          "format": "int64",
          "type": "integer"
        },
        "slots": {
          "format": "int64",
          "type": "integer"
