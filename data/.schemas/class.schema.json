          "type": "integer"
        },
        {
          "format": "double",
          "type": "number"
        }
      ]
    },
    "SaveProgressionFile": {
      "enum": [
        "good",
        "poor",
        "none"
      ],
      "type": "string"
    },
    "Skill": {
      "additionalProperties": false,
      "properties": {
        "skill": {
          "type": "string"
        }
      },
      "required": [
        "skill"
      ],
      "type": "object"
    }
