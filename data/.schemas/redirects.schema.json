{
  "$defs": {
    "EntityKind": {
      "enum": [
        "adventure-packs",
        "augments",
        "augment-slot-types",
        "bonus-types",
        "classes",
        "clickies",
        "crafting-systems",
        "crafting-ingredients",
        "damage-types",
        "effects",
        "enhancement-trees",
        "enhancements",
        "enhancement-selections",
        "equipment-slots",
        "events",
        "feats",
        "filigrees",
        "guild-buffs",
        "items",
        "optional-buffs",
        "patrons",
        "quest-chains",
        "quests",
        "races",
        "sagas",
        "sentient-gems",
        "sets",
        "spells",
        "stances",
        "vendors",
        "vendor-currencies",
        "weapon-types"
      ],
      "type": "string"
    },
    "Redirect": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "since": {
