        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "from",
        "to",
        "since"
      ],
      "type": "object",
      "x-table": "redirects"
    },
    "RemovedSlug": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EntityKind"
        },
        "reason": {
          "type": "string"
        },
        "since": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "slug",
        "since",
        "reason"
      ],
      "type": "object",
      "x-table": "removed_slugs"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "redirect": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Redirect"
      },
      "type": "array"
    },
    "removed": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RemovedSlug"
      },
      "type": "array"
