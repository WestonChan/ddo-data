        "$ref": "#/$defs/RaceGrantedFeat"
      },
      "type": "array"
    },
    "iconic_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_construct": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "no_past_life": {
      "type": "boolean"
    },
    "short_name": {
      "type": "string"
    },
    "skill_points": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "starting_world": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "description",
    "short_name",
    "starting_world"
  ],
  "title": "RaceFile",
  "type": "object",
  "x-columns": [
    "id",
    "slug",
    "name",
    "build_points",
    "description",
    "iconic_class",
    "is_construct",
    "no_past_life",
    "short_name",
    "skill_points",
    "starting_world"
  ],
  "x-table": "races"
}
