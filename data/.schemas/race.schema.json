{
  "$defs": {
    "AbilityModifier": {
      "additionalProperties": false,
      "properties": {
        "modifier": {
          "format": "int64",
          "type": "integer"
        },
        "stat": {
          "type": "string",
          "x-reference-kind": "effects"
        }
      },
      "required": [
        "modifier",
        "stat"
      ],
      "type": "object",
      "x-columns": [
        "race_id",
        "sort_order",
        "modifier",
        "stat_id"
      ],
      "x-table": "race_ability_modifiers"
    },
    "Citation": {
      "oneOf": [
        {
          "not": {
            "required": [
              "in_game"
            ]
          },
          "required": [
            "url"
          ]
        },
        {
          "not": {
            "required": [
              "url"
            ]
          },
          "required": [
            "in_game"
          ]
        }
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "in_game": {
          "const": true,
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "read": {
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "read"
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "x-array": "citation",
      "x-columns": [
        "owner_kind",
        "owner_id",
        "field",
        "url",
        "in_game",
        "read",
        "note"
      ],
      "x-table": "citations"
    },
    "RaceFeatSlot": {
      "additionalProperties": false,
      "properties": {
        "feat_type": {
          "type": "string"
        },
        "level": {
          "format": "int64",
          "type": "integer"
        },
        "update_list": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "feat_type",
        "level"
      ],
      "type": "object",
      "x-columns": [
        "race_id",
        "feat_type",
        "level",
        "update_list"
      ],
      "x-table": "race_feat_slots"
    },
    "RaceGrantedFeat": {
      "additionalProperties": false,
      "properties": {
        "feat": {
          "type": [
            "string",
            "null"
          ],
          "x-reference-kind": "feats"
        },
        "feat_name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object",
      "x-columns": [
        "race_id",
        "sort_order",
        "feat_id",
        "feat_name"
      ],
      "x-table": "race_granted_feats"
    },
    "Skill": {
      "additionalProperties": false,
      "properties": {
        "skill": {
          "type": "string"
        }
      },
      "required": [
        "skill"
      ],
      "type": "object",
      "x-columns": [
        "skill"
      ],
      "x-uses": [
        [
          "class_skills",
          "class_id"
        ],
        [
          "class_auto_buy_skills",
          "class_id"
        ],
        [
          "race_auto_buy_skills",
          "race_id"
        ]
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ability_modifier": {
      "items": {
        "$ref": "#/$defs/AbilityModifier"
      },
      "type": "array"
    },
    "auto_buy_skill": {
      "items": {
        "$ref": "#/$defs/Skill"
      },
      "type": "array"
    },
    "build_points": {
      "items": {
        "format": "int64",
        "type": "integer"
      },
      "type": "array"
    },
    "citation": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "type": "array"
    },
    "description": {
      "type": "string"
    },
    "feat_slot": {
